# Copy this file to .env and adjust as needed for your environment.
# For e2e tests (npm run test:e2e), also copy .env.test.example to
# .env.test — a separate database so test cleanup never touches this one.

# Local dev SQL Server (matches docker-compose.yml defaults)
MSSQL_SA_PASSWORD="DevP@ssw0rd123!"
DATABASE_URL="sqlserver://localhost:1433;database=webprolific_dev;user=sa;password=DevP@ssw0rd123!;trustServerCertificate=true"

PORT=3000

# FR-13: Authentication & 2FA
# JWT_ACCESS_SECRET: any long random string in dev; a real secret manager value in prod.
JWT_ACCESS_SECRET="dev-only-change-me-1f8a9c2e4b6d7f01"
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN_DAYS=30
PENDING_2FA_TOKEN_TTL_MIN=10
TRUSTED_DEVICE_TTL_DAYS=30
# TOTP_ENCRYPTION_KEY: 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`).
TOTP_ENCRYPTION_KEY="4h2sM9pQeYVvXk1n8Zt6rC0dJb3fL5wA7gU2iN9oR4E="

# Email delivery (2FA codes, password resets, invites, PO/GRN documents).
# Leave RESEND_API_KEY unset and everything is logged to the console instead of
# sent — see EmailModule. Set it and mail really goes out; there is no silent
# middle ground in either direction.
#
# RESEND_API_KEY: from https://resend.com/api-keys — starts with "re_".
#RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM: until you verify a domain in Resend, keep onboarding@resend.dev
# (Resend then only delivers to the address that owns the account).
EMAIL_FROM="onboarding@resend.dev"
# APP_BASE_URL: origin used to build links in emails, e.g. the password-reset
# link. The Vite dev server in dev; your real domain in production.
APP_BASE_URL="http://localhost:5173"
# EMAIL_PROVIDER=dev forces console logging even when a key is set.
#EMAIL_PROVIDER=dev

# FR-06: POS webhook (Model 1). The POS signs each request body with this
# shared secret (HMAC-SHA256, lowercase hex, in the X-Pos-Signature header).
# Leave it unset and /pos-webhook/* rejects everything — the endpoint moves
# real stock, so an unconfigured secret fails closed rather than open.
POS_WEBHOOK_SECRET="dev-only-pos-secret-change-me"
